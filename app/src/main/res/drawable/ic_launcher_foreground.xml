<?xml version="1.0" encoding="utf-8"?>
<!-- Campusly logo: a lime speech bubble with a black "C".
     Adaptive icons are 108x108; only the middle ~66x66 is always visible,
     so the logo stays inside that area. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Speech bubble body -->
    <path
        android:fillColor="#C6FF4A"
        android:pathData="M42,30 L66,30 A12,12 0 0 1 78,42 L78,60 A12,12 0 0 1 66,72 L42,72 A12,12 0 0 1 30,60 L30,42 A12,12 0 0 1 42,30 Z" />

    <!-- Speech bubble tail -->
    <path
        android:fillColor="#C6FF4A"
        android:pathData="M36,68 L36,82 L48,72 Z" />

    <!-- The letter "C" -->
    <path
        android:pathData="M61.78,43.22 A11,11 0 1 0 61.78,58.78"
        android:strokeWidth="5"
        android:strokeColor="#000000"
        android:strokeLineCap="round" />
</vector>