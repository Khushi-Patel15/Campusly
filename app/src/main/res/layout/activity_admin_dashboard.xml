<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/campus_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <TextView
            style="@style/ScreenTitle"
            android:layout_marginHorizontal="20dp"
            android:text="@string/admin_title" />

        <TextView
            style="@style/ScreenSubtitle"
            android:layout_marginHorizontal="20dp"
            android:text="@string/admin_subtitle" />

        <!-- Moderation statistics, 2 x 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:orientation="horizontal">

            <LinearLayout style="@style/StatTile">

                <TextView
                    android:id="@+id/statOpenReports"
                    style="@style/StatNumber"
                    android:textColor="@color/neon_red" />

                <TextView
                    style="@style/StatLabel"
                    android:text="@string/admin_stat_open" />
            </LinearLayout>

            <LinearLayout
                style="@style/StatTile"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/statResolvedReports"
                    style="@style/StatNumber" />

                <TextView
                    style="@style/StatLabel"
                    android:text="@string/admin_stat_resolved" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout style="@style/StatTile">

                <TextView
                    android:id="@+id/statPosts"
                    style="@style/StatNumber" />

                <TextView
                    style="@style/StatLabel"
                    android:text="@string/admin_stat_posts" />
            </LinearLayout>

            <LinearLayout
                style="@style/StatTile"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/statUsers"
                    style="@style/StatNumber" />

                <TextView
                    style="@style/StatLabel"
                    android:text="@string/admin_stat_users" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="@string/admin_open_reports"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/reportsProgress"
            style="@style/LoadingSpinner"
            android:visibility="visible" />

        <TextView
            android:id="@+id/reportsEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/reportsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
