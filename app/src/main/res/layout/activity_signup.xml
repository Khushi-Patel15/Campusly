<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/campus_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingTop="48dp">

        <TextView
            style="@style/ScreenTitle"
            android:text="@string/signup_title" />

        <TextView
            android:id="@+id/signupSubtitleText"
            style="@style/ScreenSubtitle"
            android:text="@string/signup_subtitle" />

        <EditText
            android:id="@+id/nameInput"
            style="@style/CampusInput"
            android:autofillHints="name"
            android:hint="@string/hint_name"
            android:inputType="textPersonName|textCapWords" />

        <EditText
            android:id="@+id/emailInput"
            style="@style/CampusInput"
            android:autofillHints="emailAddress"
            android:hint="@string/hint_email"
            android:inputType="textEmailAddress" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_school" />

        <Spinner
            android:id="@+id/schoolSpinner"
            style="@style/CampusSpinner" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_year" />

        <Spinner
            android:id="@+id/yearSpinner"
            style="@style/CampusSpinner" />

        <EditText
            android:id="@+id/passwordInput"
            style="@style/CampusInput"
            android:autofillHints="newPassword"
            android:hint="@string/hint_password"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/confirmPasswordInput"
            style="@style/CampusInput"
            android:autofillHints="newPassword"
            android:hint="@string/hint_confirm_password"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/signupButton"
            style="@style/PrimaryButton"
            android:text="@string/signup_button" />

        <ProgressBar
            android:id="@+id/signupProgress"
            style="@style/LoadingSpinner" />

        <TextView
            android:id="@+id/goToLoginText"
            style="@style/LinkText"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:text="@string/go_to_login" />

    </LinearLayout>

</ScrollView>
