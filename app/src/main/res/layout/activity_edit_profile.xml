<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/campus_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/ScreenTitle"
            android:layout_marginTop="12dp"
            android:text="@string/edit_profile_title" />

        <TextView
            style="@style/ScreenSubtitle"
            android:text="@string/edit_profile_subtitle" />

        <EditText
            android:id="@+id/nameInput"
            style="@style/CampusInput"
            android:autofillHints="name"
            android:hint="@string/hint_name"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="50" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_school" />

        <Spinner
            android:id="@+id/schoolSpinner"
            style="@style/CampusSpinner" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_year" />

        <Spinner
            android:id="@+id/yearSpinner"
            style="@style/CampusSpinner" />

        <EditText
            android:id="@+id/bioInput"
            style="@style/CampusInput"
            android:gravity="top|start"
            android:hint="@string/hint_bio"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="160"
            android:minLines="3" />

        <TextView
            android:id="@+id/saveProfileButton"
            style="@style/PrimaryButton"
            android:text="@string/edit_profile_save" />

        <ProgressBar
            android:id="@+id/editProfileProgress"
            style="@style/LoadingSpinner" />

    </LinearLayout>

</ScrollView>
