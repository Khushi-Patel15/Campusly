<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/campus_black"
    android:orientation="vertical"
    android:padding="24dp"
    android:paddingTop="64dp">

    <TextView
        style="@style/ScreenTitle"
        android:text="@string/verify_title" />

    <TextView
        android:id="@+id/verifyMessageText"
        style="@style/ScreenSubtitle"
        android:layout_marginTop="12dp"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/checkVerifiedButton"
        style="@style/PrimaryButton"
        android:text="@string/verify_check_button" />

    <TextView
        android:id="@+id/resendButton"
        style="@style/SecondaryButton"
        android:text="@string/verify_resend_button" />

    <ProgressBar
        android:id="@+id/verifyProgress"
        style="@style/LoadingSpinner" />

    <TextView
        android:id="@+id/useOtherAccountText"
        style="@style/LinkText"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:text="@string/verify_use_other_account" />

</LinearLayout>